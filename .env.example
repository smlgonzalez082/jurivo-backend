# Copy to .env.local and fill in. Never commit a filled-in copy.

# --- Database (matches docker-compose.yml) -----------------------------------
DB_URL=jdbc:postgresql://localhost:5442/jurivo_dev
DB_USER=jurivo
DB_PASSWORD=jurivo_dev

# --- Amazon Cognito ----------------------------------------------------------
# Issuer of the user pool: https://cognito-idp.{region}.amazonaws.com/{userPoolId}
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
# Comma-separated app client ids this API accepts. These are matched against the
# `client_id` claim — a Cognito ACCESS token has no `aud` claim.
COGNITO_CLIENT_IDS=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Only needed as a fallback for reading user attributes when the access
# token carries no `email` claim (i.e. when the pre-token-generation Lambda is absent).
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_REGION=us-east-1

# --- Web ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:7500
